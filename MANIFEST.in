include LICENSE
include README.md
include logo.png
include CHANGELOG.md
include pyproject.toml
include setup.cfg
include setup.py
recursive-include packages/carvustrain/src/carvustrain *.py *.typed
recursive-include docs *.md *.mmd *.svg *.gif
recursive-include examples *.py
recursive-include tests *.py
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.so
global-exclude .DS_Store
